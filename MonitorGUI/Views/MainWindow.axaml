<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MonitorGUI.ViewModels"
        xmlns:dt="using:MonitorGUI.DesignTime"
        xmlns:conv="using:MonitorGUI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="850"
        x:Class="MonitorGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Monitor de Processos: Visualização Mestre-Detalhe (Threads e Memória)"
        Background="#1E1E1E">

    <Design.DataContext>
        <dt:DesignTimeMainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:BytesLegiveisConverter x:Key="BytesLegiveisConverter"/>
        <conv:NuloParaTextoConverter x:Key="NuloParaTextoConverter"/>
        <conv:TipoDeRegiaoParaCorConverter x:Key="TipoDeRegiaoParaCorConverter"/>
        <conv:TempoDeCpuParaTextoConverter x:Key="TempoDeCpuParaTextoConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Estilos do bloco de memória: movidos do DataTemplate inline (onde viviam antes) para
             cá, como estilos do controle. A seleção do bloco usa a classe "selecionado", ligada
             via Classes.selecionado="{Binding IsSelected}" — nada de BorderThickness bindado a
             um bool via ObjectConverters.IsNull, que nunca fez sentido. -->
        <Style Selector="Button.bloco-memoria">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#222222"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Button.bloco-memoria:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Button.bloco-memoria.selecionado">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MONITOR DE PROCESSOS E THREADS" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Com Master-Detail em tempo real" FontSize="14" Foreground="#CCCCCC"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Foreground="White"/>
                    <ComboBox ItemsSource="{Binding OpcoesFiltro}" SelectedItem="{Binding FiltroSelecionado}" Width="130" Background="#3E3E42" Foreground="White" />

                    <TextBlock Text="Limite:" VerticalAlignment="Center" Foreground="White" Margin="10,0,0,0"/>
                    <ComboBox ItemsSource="{Binding OpcoesLimite}" SelectedItem="{Binding LimiteSelecionado}" Width="80" Background="#3E3E42" Foreground="White"/>

                    <TextBlock Text="Ciclo (ms):" VerticalAlignment="Center" Foreground="White" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding IntervalMs}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#42A5F5" Width="50"/>
                    <Button Command="{Binding DecreaseIntervalCommand}" Content="-" Width="30" HorizontalContentAlignment="Center"/>
                    <Button Command="{Binding IncreaseIntervalCommand}" Content="+" Width="30" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Iniciar Monitor" Command="{Binding StartMonitoringCommand}"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Pausar" Command="{Binding StopMonitoringCommand}"
                            Background="#F44336" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (Master-Detail) -->
        <Grid Grid.Row="1" RowDefinitions="*, 5, *">

            <!-- Process List (Master) -->
            <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="10">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="LISTA DE PROCESSOS (Selecione um para ver as Threads e o Mapa de Memória)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                    <!-- DataGrid Mestre -->
                    <DataGrid x:Name="GradeDeProcessos" Grid.Row="1" ItemsSource="{Binding Processos}" SelectedItem="{Binding ProcessoSelecionado}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="All" BorderThickness="1" BorderBrush="#333333">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                            <DataGridTextColumn Header="Nome do Processo" Binding="{Binding Nome}" Width="180" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoProcessoTexto}" />
                            <DataGridTextColumn Header="Perfil de Execução" Binding="{Binding PerfilTexto}" />
                            <DataGridTextColumn Header="% CPU" Binding="{Binding PorcentagemCpu, StringFormat='{}{0:F1}%'}" />
                            <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" />
                            <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount, Converter={StaticResource NuloParaTextoConverter}}" />
                            <DataGridTextColumn Header="Memória Residente" Binding="{Binding MemoriaResidente, Converter={StaticResource BytesLegiveisConverter}}" />
                            <!-- Cabeçalho desta coluna é atualizado em código (MainWindow.axaml.cs) para
                                 refletir o tamanho de página REAL da amostra ("Páginas (16 KiB)"). -->
                            <DataGridTextColumn Header="Páginas" Binding="{Binding Paginas, Converter={StaticResource NuloParaTextoConverter}}" />
                            <DataGridTextColumn Header="Início da Execução" Binding="{Binding InicioDaExecucao, StringFormat='{}{0:HH:mm:ss}', TargetNullValue='—'}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- GridSplitter Flexível Central -->
            <GridSplitter Grid.Row="1" Background="#007ACC" ResizeDirection="Rows" ShowsPreview="True" Margin="0,2"/>

            <!-- Detail Section (Threads + Memory Map) -->
            <Grid Grid.Row="2" ColumnDefinitions="2*, 5, 1*">

                <!-- Thread List (Detail Left) -->
                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="10" BorderBrush="#333333" BorderThickness="1">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="THREADS DO PROCESSO: " FontSize="16" FontWeight="Bold" Foreground="#42A5F5"/>
                            <TextBlock Text="{Binding ProcessoSelecionado.Nome, TargetNullValue='(NENHUM SELECIONADO)'}" FontSize="16" FontWeight="Bold" Foreground="#FFCA28"/>
                            <TextBlock Text="{Binding ProcessoSelecionado.Pid, StringFormat=' [PID: {0}]', TargetNullValue=''}" FontSize="16" Foreground="#AAAAAA"/>
                        </StackPanel>

                        <!-- DataGrid Detalhe -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ThreadsSelecionadas}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="#333333">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="TID">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ThreadItemViewModel">
                                            <TextBlock Text="{Binding TidTexto}" ToolTip.Tip="{Binding TidTooltip}"
                                                       VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" />
                                <DataGridTextColumn Header="Motivo do bloqueio" Binding="{Binding MotivoDeBloqueioTexto}" Width="*" />
                                <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade, Converter={StaticResource NuloParaTextoConverter}}" />
                                <DataGridTextColumn Header="Tempo de CPU" Binding="{Binding TempoDeCpu, Converter={StaticResource TempoDeCpuParaTextoConverter}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Legenda didática dos estados de thread (Tanenbaum) -->
                        <TextBlock Grid.Row="2" FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Pronta = aguardando CPU · Executando = na CPU · Bloqueada = aguardando evento/E-S · Terminada = não será mais escalonada (modelo de estados de processo/thread de Tanenbaum)"/>
                    </Grid>
                </Border>

                <!-- GridSplitter Vertical -->
                <GridSplitter Grid.Column="1" Background="#007ACC" ResizeDirection="Columns" Margin="2,0"/>

                <!-- Memory Map View (Detail Right) -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="10" BorderBrush="#333333" BorderThickness="1">
                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto">
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <!-- Rótulo obrigatório da origem: "MAPA DE MEMÓRIA REAL (medido do SO)" vs "MAPA SIMULADO (modo didático)" -->
                            <TextBlock Text="{Binding RotuloOrigemDoMapa}" FontSize="13" FontWeight="Bold" Foreground="#66BB6A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MotivoDoFallbackTexto, StringFormat='Motivo: {0}'}" FontSize="10" Foreground="#FFB300" TextWrapping="Wrap"
                                       IsVisible="{Binding MotivoDoFallbackTexto, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <!-- Medição honesta: responde "por que o mapa não atualiza tão rápido quanto a lista" com um número, não um parágrafo. -->
                            <TextBlock Text="{Binding DuracaoDaUltimaLeituraDoMapa}" FontSize="10" Foreground="#888888"
                                       IsVisible="{Binding DuracaoDaUltimaLeituraDoMapa, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <Button Content="Atualizar mapa" Command="{Binding AtualizarMapaCommand}"/>
                            <TextBlock Text="Blocos:" VerticalAlignment="Center" Foreground="White" Margin="10,0,0,0"/>
                            <ComboBox ItemsSource="{Binding OpcoesQuantidadeDeBlocos}" SelectedItem="{Binding QuantidadeDeBlocosSelecionada}"
                                      Width="70" Background="#3E3E42" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                            <CheckBox Content="Auto" IsChecked="{Binding AtualizacaoAutomaticaDoMapa}" Foreground="White"/>
                            <TextBlock Text="a cada" VerticalAlignment="Center" Foreground="White"/>
                            <ComboBox ItemsSource="{Binding OpcoesIntervaloDoMapaEmSegundos}" SelectedItem="{Binding IntervaloDoMapaEmSegundos}"
                                      Width="55" Background="#3E3E42" Foreground="White"/>
                            <TextBlock Text="s" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>

                        <!-- Grade de blocos: cada bloco = uma região real de memória -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding BlocosDeMemoria}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="20" ItemHeight="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BlocoDeMemoriaViewModel">
                                        <Button Width="18" Height="18" Margin="1"
                                                Classes="bloco-memoria"
                                                Classes.selecionado="{Binding IsSelected}"
                                                Background="{Binding TipoDeRegiao, Converter={StaticResource TipoDeRegiaoParaCorConverter}}"
                                                ToolTip.Tip="{Binding TooltipDidatico}"
                                                Command="{Binding SelecionarCommand}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Detalhes do Bloco Selecionado: dados REAIS (endereços, permissões, residência) -->
                        <Border Grid.Row="4" Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="8" MinHeight="150" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel IsVisible="{Binding BlocoSelecionado, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding BlocoSelecionado.Rotulo}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BlocoSelecionado.FaixaHexTexto}" FontFamily="Monospace" FontSize="11" Foreground="#CCCCCC" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding BlocoSelecionado.PermissoesTexto, StringFormat='Permissões: {0}'}" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock Text="{Binding BlocoSelecionado.ResidenteBytes, Converter={StaticResource BytesLegiveisConverter}, StringFormat='Residente: {0}'}" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock Text="{Binding BlocoSelecionado.EmSwapBytes, Converter={StaticResource BytesLegiveisConverter}, StringFormat='Em swap: {0}'}" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock Text="{Binding BlocoSelecionado.TextoDidatico}" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <TextBlock IsVisible="{Binding BlocoSelecionado, Converter={x:Static ObjectConverters.IsNull}}"
                                           Text="Clique em um bloco de memória acima para ver os dados reais da região."
                                           Foreground="#888888" TextWrapping="Wrap" FontStyle="Italic"/>
                            </Grid>
                        </Border>

                        <!-- Legenda de cores do mapa -->
                        <WrapPanel Grid.Row="5" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoCodigo}" CornerRadius="2"/>
                                <TextBlock Text="Código" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoDados}" CornerRadius="2"/>
                                <TextBlock Text="Dados estáticos" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoHeap}" CornerRadius="2"/>
                                <TextBlock Text="Heap" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoPilha}" CornerRadius="2"/>
                                <TextBlock Text="Pilha" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoBiblioteca}" CornerRadius="2"/>
                                <TextBlock Text="Biblioteca" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoArquivoMapeado}" CornerRadius="2"/>
                                <TextBlock Text="Arquivo mapeado" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoReservada}" CornerRadius="2"/>
                                <TextBlock Text="Reservada/em swap" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" Spacing="4">
                                <Border Width="10" Height="10" Background="{StaticResource CorRegiaoOutra}" CornerRadius="2"/>
                                <TextBlock Text="Outra" FontSize="10" Foreground="#AAAAAA"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer / StatusBar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,5" Margin="0,10,0,0" CornerRadius="5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold"/>
        </Border>
    </Grid>

</Window>
